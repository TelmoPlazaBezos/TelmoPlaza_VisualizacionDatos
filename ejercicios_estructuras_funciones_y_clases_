   "source": [
    "from datetime import datetime, timedelta\n",
    "\n",
    "# primer día de clase: 14 de septiembre de 2026\n",
    "fecha_actual = datetime(2026, 9, 14)\n",
    "fecha_fin = datetime(2026, 12, 4)\n",
    "\n",
    "# festivos\n",
    "festivos = [\n",
    "    datetime(2026, 10, 12).date(),\n",
    "    datetime(2026, 11, 2).date()\n",
    "]\n",
    "\n",
    "# fechas definitivas\n",
    "fechas_clase = []\n",
    "\n",
    "# bucle para recorrer los días\n",
    "while fecha_actual <= fecha_fin:\n",
    "    \n",
    "    # Comprobar si el día es lunes \n",
    "    es_lunes = (fecha_actual.weekday() == 0)\n",
    "    \n",
    "    # Comprobar si la fecha está en la lista de festivos\n",
    "    es_festivo = (fecha_actual.date() in festivos)\n",
    "    \n",
    "    # Si es lunes y NO es festivo, añadimos la fecha a la lista\n",
    "    if es_lunes and not es_festivo:\n",
    "        # Formateamos la fecha como Día-Mes-Año y le añadimos el horario a mano\n",
    "        texto_clase = fecha_actual.strftime(\"%d-%m-%Y\") + \" de 15:00 a 16:50\"\n",
    "        fechas_clase.append(texto_clase)\n",
    "        \n",
    "    # Sumar 1 día para revisar el siguiente\n",
    "    fecha_actual += timedelta(days=1)\n",
    "\n",
    "# 5. Iterar sobre la lista creada para mostrar los resultados\n",
    "print(\"Tus clases serán los siguientes días:\")\n",
    "print(\"=\" * 10)\n",
    "for clase in fechas_clase:\n",
    "    print(clase)"
   ]
