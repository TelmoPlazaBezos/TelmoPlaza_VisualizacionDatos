    "E3: Definición de clases\n",
    "Define una clase de números complejos cuyos métodos sean, al menos, el módulo y el argumento."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "c95274ec",
   "metadata": {},
   "outputs": [],
   "source": [
    "import math\n",
    "\n",
    "class NumeroComplejo:\n",
    "    def __init__(self, real, imag):\n",
    "        self.real = real\n",
    "        self.imag = imag\n",
    "\n",
    "    def modulo(self):\n",
    "        # math.hypot calcula directamente la raíz cuadrada de la suma de los cuadrados\n",
    "        return math.hypot(self.real, self.imag)\n",
    "\n",
    "    def argumento(self):\n",
    "        # math.atan2 calcula el ángulo en radianes sin dar errores\n",
    "        return math.atan2(self.imag, self.real)\n",
    "\n",
    "    def __repr__(self):\n",
    "        # Lo muestra en formato básico de texto, ej: \"3 + 4i\"\n",
    "        return f\"{self.real} + {self.imag}i\""
   ]
