  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "3b9955f6",
   "metadata": {},
   "outputs": [],
   "source": [
    "def sumar(c1, c2):\n",
    "    suma_real = c1.real + c2.real\n",
    "    suma_imag = c1.imag + c2.imag\n",
    "    return NumeroComplejo(suma_real, suma_imag)\n",
    "\n",
    "def restar(c1, c2):\n",
    "    # Se restan las partes reales y las imaginarias\n",
    "    resta_real = c1.real - c2.real\n",
    "    resta_imag = c1.imag - c2.imag\n",
    "    return NumeroComplejo(resta_real, resta_imag)\n",
    "\n",
    "def multiplicar(c1, c2):\n",
    "    # Fórmula: (a+bi) * (c+di) = (ac - bd) + (ad + bc)i\n",
    "    prod_real = (c1.real * c2.real) - (c1.imag * c2.imag)\n",
    "    prod_imag = (c1.real * c2.imag) + (c1.imag * c2.real)\n",
    "    return NumeroComplejo(prod_real, prod_imag)\n",
    "\n",
    "def dividir(c1, c2):\n",
    "    # Denominador común: c^2 + d^2\n",
    "    denominador = c2.real**2 + c2.imag**2\n",
    "    \n",
    "    # Fórmula para la parte real y la imaginaria\n",
    "    nuevo_real = (c1.real * c2.real + c1.imag * c2.imag) / denominador\n",
    "    nuevo_imag = (c1.imag * c2.real - c1.real * c2.imag) / denominador\n",
    "    return NumeroComplejo(nuevo_real, nuevo_imag)\n",
    "\n"
   ]
